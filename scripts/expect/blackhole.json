{
  "#lab-surfaceg": [
    { "label": "태양 — 표 1행 (274 m/s², 618 km/s)",
      "set":    { "M": 1, "R": 696000 },
      "expect": { "g": [274.0, 0.5], "ve": [617.6, 1.0], "vc": [0.00206, 0.0001] } },
    { "label": "시리우스 B — 표 2행 (4.0×10⁶ m/s², 6,800 km/s)",
      "set":    { "M": 1.02, "R": 5800 },
      "expect": { "g": [4.025e6, 1e4], "ve": [6833, 20] } },
    { "label": "중성자별 — 표 3행 (1.3×10¹² m/s², 0.59 c)",
      "set":    { "M": 1.4, "R": 12 },
      "expect": { "g": [1.2906e12, 2e9], "vc": [0.587, 0.003] } }
  ],
  "#lab-rs": [
    { "label": "1 M☉ → r_s 2.95 km · ISCO 8.9 km",
      "set":    { "M": 1 },
      "expect": { "rs": [2.954, 0.005], "isco": [8.861, 0.01], "rho": [1.843e19, 5e16] } },
    { "label": "은하 중심 4.3×10⁶ M☉",
      "set":    { "M": 4.3e6 },
      "expect": { "rs": [1.2701e7, 2e4] } }
  ],
  "#lab-veff": [
    { "label": "L̃ = 2.5 r_s — 원궤도 두 해",
      "set":    { "L": 2.5 },
      "expect": { "rp": [10.757, 0.01], "rm": [1.7431, 0.01], "nw": [6.25, 0.01] } },
    { "label": "L̃ = √3 r_s — 두 해가 ISCO 3 r_s 에서 만남",
      "set":    { "L": 1.7320508 },
      "expect": { "rp": [3.0, 0.01], "rm": [3.0, 0.01] } }
  ],
  "#lab-binding": [
    { "label": "태양 |U| = 2.28×10⁴¹ J, 백색왜성까지 120배",
      "set":    { "M": 1, "Ri": 696000, "Rf": 5800 },
      "expect": { "ui": [2.2763e41, 1e38], "uf": [2.7316e43, 1e40], "du": [2.7088e43, 1e40] } }
  ],
  "#lab-gfield": [
    { "label": "1 AU 의 g 는 압축과 무관",
      "set":    { "M": 1, "R": 2.95 },
      "expect": { "gau": [0.0059314, 1e-6], "gs0": [274.27, 0.5] } },
    { "label": "압축해도 1 AU 값이 같음",
      "set":    { "M": 1, "R": 696000 },
      "expect": { "gau": [0.0059314, 1e-6] } }
  ]
}
