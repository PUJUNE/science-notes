    {"label":"분리된 flux 감소 1/33",   "set":{"rFlux":33,"delta":100,"L":20,"D":1e-5,"Dr":0.01},  "expect":{"Rmem":[32000,10],"P":[6.25e-8,1e-11],"K":[0.625,1e-3]}},
    {"label":"PEI/PTGE 1/2000",         "set":{"rFlux":2000,"delta":100,"L":20,"D":1e-5,"Dr":0.01},"expect":{"Rmem":[1999000,100],"P":[1.0005e-9,1e-12],"K":[1.0005e-2,1e-5]}},
    {"label":"막 안 확산이 수용액과 같음","set":{"rFlux":100,"delta":100,"L":20,"D":1e-5,"Dr":1},   "expect":{"K":[2.0202e-3,1e-6]}},
    {"label":"막 안 확산이 1/1000",     "set":{"rFlux":100,"delta":100,"L":20,"D":1e-5,"Dr":1e-3}, "expect":{"K":[2.0202,1e-3]}}
