    {"label":"설계 조건 1/100",           "set":{"rI":100,"rV":1,"i0":100}, "expect":{"flux":[100,0.01],"i5":[1,0.001]}}
  ],
  "#lab-3elec": [
    {"label":"100 μA · 1 kΩ 순수 iR", "set":{"i":100,"Rs":1000,"f":0.1,"eta":0,"tol":10},  "expect":{"e2":[100,0.01],"e3":[10,0.01]}},
    {"label":"0.25 μA · 1 kΩ",        "set":{"i":0.25,"Rs":1000,"f":0.1,"eta":0,"tol":10}, "expect":{"e2":[0.25,0.001],"e3":[0.025,0.001]}}
  ],
  "#lab-ref": [
    {"label":"25 °C 십진 기울기",        "set":{"C":3,"C0":3,"T":25},      "expect":{"slope":[59.16,0.02],"dE":[0,0.001]}},
    {"label":"PBS 0.1396 M 대 3 M KCl", "set":{"C":0.1396,"C0":3,"T":25}, "expect":{"dE":[78.8,0.2]}}
  ],
  "#lab-turnover": [
    {"label":"400 U/mg × 19 μg = 7.6 U", "set":{"act":400,"m":19,"n":2,"vmax":0.45}, "expect":{"U":[7.6,0.01],"ith":[24.44,0.02],"ratio":[1.84,0.02]}},
    {"label":"Vmax 하한 0.4 mA",         "set":{"act":400,"m":19,"n":2,"vmax":0.4},  "expect":{"ratio":[1.636,0.01]}}
  ],
  "#lab-permeability": [
