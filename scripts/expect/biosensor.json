{
  "#lab-oxygen": [
    {"label":"교차 농도 = iO2·KM/(imax−iO2)", "set":{"imax":400,"KM":20,"iO2":60}, "expect":{"ic":[3.529,0.01],"i20":[60,0.1]}},
    {"label":"산소 충분이면 효소 곡선 그대로", "set":{"imax":400,"KM":20,"iO2":500}, "expect":{"i5":[80,0.1],"err":[0,0.001]}}
  ],
  "#lab-mm": [
    {"label":"imax 500 · KM 20 · 5 mM", "set":{"imax":500,"KM":20,"C":5},  "expect":{"i":[100,0.01],"sens":[25,0.01],"lin":[80,0.01]}},
