    {"label":"층 두께 절반",        "set":{"Jin":5,"Jout":3,"dx":5,"A":1},   "expect":{"net":[2,0.001],"dCdt":[4000,1]}},
    {"label":"유속이 같은 경우",     "set":{"Jin":5,"Jout":5,"dx":10,"A":1},  "expect":{"net":[0,0.001],"dCdt":[0,0.001]}}
  ],
  "#lab-calc": [
    {"label":"표 0.01 s", "set":{"D":1e-5,"t":0.01,"n":1,"A":1,"Cs":1}, "expect":{"d":[5.6,0.1],"i":[1721,1]}},
    {"label":"표 0.1 s",  "set":{"D":1e-5,"t":0.1, "n":1,"A":1,"Cs":1}, "expect":{"d":[17.7,0.1],"i":[544,1]}},
    {"label":"표 1 s",    "set":{"D":1e-5,"t":1,   "n":1,"A":1,"Cs":1}, "expect":{"d":[56.0,0.1],"i":[172,1]}},
    {"label":"표 10 s",   "set":{"D":1e-5,"t":10,  "n":1,"A":1,"Cs":1}, "expect":{"d":[177.2,0.1],"i":[54,1]}},
    {"label":"표 100 s",  "set":{"D":1e-5,"t":100, "n":1,"A":1,"Cs":1}, "expect":{"d":[560.5,0.1],"i":[17,1]}}
  ],
  "#lab-warburg": [
    {"label":"20 Hz",  "set":{"sig":100,"D":1e-5,"f":20},   "expect":{"dac":[3.99e-6,1e-7]}},
    {"label":"36 kHz", "set":{"sig":100,"D":1e-5,"f":36000},"expect":{"dac":[9.40e-8,2e-9]}},
    {"label":"60 kHz", "set":{"sig":100,"D":1e-5,"f":60000},"expect":{"dac":[7.28e-8,2e-9]}}
  ],
  "#lab-partition": [
    {"label":"소수성 막 K=0.1",     "set":{"D":1e-5,"delta":100,"L":20,"Dr":0.01,"K":0.1},   "expect":{"Raq":[1000,1],"Rmem":[200000,10],"frac":[99.502,0.01],"red":[201.0,0.05],"lag":[6.667,0.01]}},
    {"label":"친수성 하이드로겔",    "set":{"D":1e-5,"delta":100,"L":20,"Dr":0.1,"K":1},      "expect":{"Rmem":[2000,1],"frac":[66.667,0.01],"red":[3.0,0.01],"lag":[0.6667,0.001]}},
    {"label":"막 두께만 두 배",      "set":{"D":1e-5,"delta":100,"L":40,"Dr":0.01,"K":0.1},   "expect":{"Rmem":[400000,10],"red":[401.0,0.05],"lag":[26.667,0.01]}},
    {"label":"K만 1/100",           "set":{"D":1e-5,"delta":100,"L":20,"Dr":0.01,"K":0.001}, "expect":{"Rmem":[2e7,1e4],"red":[20001.0,1]}},
    {"label":"막이 거의 없는 경우",  "set":{"D":1e-5,"delta":100,"L":1,"Dr":1,"K":1},         "expect":{"Rmem":[10,0.01],"frac":[0.990,0.005],"red":[1.01,0.001]}}
  ],
  "#lab-profile": [
